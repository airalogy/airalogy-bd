# Candidate only; verify on the actual Linux deployment host.
BD_DOCKER_SUBNET=192.168.247.0/24
NETWORK_PREFLIGHT_CLOUD=aliyun
# Add peered VPC/VPN/LAN CIDRs; manual mode (cloud=none) requires CIDRs or explicit none.
NETWORK_PREFLIGHT_PROTECTED_CIDRS=
# Optional dependency hostnames/URLs, including other apps on this host.
NETWORK_PREFLIGHT_ENDPOINTS=

# Choose a published image version or the digest supplied with its GitHub Release.
BD_IMAGE=ghcr.io/airalogy/airalogy-bd:RELEASE_VERSION
BD_PUBLIC_URL=https://bd.example.com
# Optional site identity. The logo is public on the login page; never point at private business files.
BD_BRAND_NAME=Airalogy BD
# Absolute path inside the container to a PNG/JPEG/WebP file, up to 1 MiB.
# Mount that file read-only in a compose override; leave empty to use airalogy-logo.svg.
BD_BRAND_LOGO_FILE=
# Generate once with: openssl rand -hex 32. Keep in your company password manager.
# Required for session signing and encryption of authenticator secrets.
BETTER_AUTH_SECRET=
# Optional email ownership verification; 0 keeps invitation + password + authenticator login.
# Configure and test your SMTP service before setting this to 1 and restarting.
BD_REQUIRE_EMAIL_VERIFICATION=0
BD_SMTP_HOST=
# 465 uses TLS directly; other ports require STARTTLS and a valid server certificate.
BD_SMTP_PORT=465
BD_SMTP_USER=
BD_SMTP_PASSWORD=
# A single sender email address authorized by your SMTP service.
BD_MAIL_FROM=
BD_BACKUP_ENABLED=1
BD_BACKUP_INTERVAL_MINUTES=60
BD_BACKUP_RETENTION_DAYS=30
# Enable only after creating a private bucket and configuring a dedicated RAM identity.
BD_OSS_BACKUP=0
BD_OSS_REGION=cn-hangzhou
BD_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
BD_OSS_BUCKET=
BD_OSS_PREFIX=bd-backups
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional, only when using temporary STS credentials; renew before expiry.
OSS_SESSION_TOKEN=
