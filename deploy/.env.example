BD_PUBLIC_URL=https://bd.example.com
# Generate once with: openssl rand -hex 32. Keep in your company password manager.
# Required for session signing and encryption of authenticator secrets.
BETTER_AUTH_SECRET=
BD_BACKUP_ENABLED=1
BD_BACKUP_INTERVAL_MINUTES=60
BD_BACKUP_RETENTION_DAYS=30
# Enable only after creating a private bucket and configuring a dedicated RAM identity.
BD_OSS_BACKUP=0
BD_OSS_REGION=cn-hangzhou
BD_OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
BD_OSS_BUCKET=
BD_OSS_PREFIX=bd-backups
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# Optional, only when using temporary STS credentials; renew before expiry.
OSS_SESSION_TOKEN=
