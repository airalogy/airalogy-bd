# Place limit_req_zone in the existing nginx http {} block, once.
limit_req_zone $binary_remote_addr zone=bd_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=bd_remote:10m rate=60r/m;
limit_conn_zone $binary_remote_addr zone=bd_remote_connections:10m;

server {
    listen 80;
    server_name bd.example.com;
    return 301 https://bd.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name bd.example.com;
    ssl_certificate /etc/nginx/tls/bd.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/bd.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 55m;
    proxy_read_timeout 310s;
    proxy_send_timeout 310s;
    proxy_buffering off;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    location = /api/auth {
        limit_req zone=bd_auth burst=15 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:3100;
    }
    location = /api/mcp {
        limit_req zone=bd_remote burst=20 nodelay;
        limit_req_status 429;
        limit_conn bd_remote_connections 10;
        limit_conn_status 429;
        client_max_body_size 24k;
        proxy_pass http://127.0.0.1:3100;
    }
    location / {
        proxy_pass http://127.0.0.1:3100;
    }
}
