#!/usr/bin/env bash
# Deployment-host entry point; no automatic subnet changes or volume removal.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE_FILE="${BD_COMPOSE_FILE:-$SCRIPT_DIR/compose.yaml}"
DEPLOY_DIR="$(cd "$(dirname "$COMPOSE_FILE")" && pwd)"
COMPOSE_FILE="$DEPLOY_DIR/$(basename "$COMPOSE_FILE")"
export BD_DEPLOY_ENV_FILE="${BD_DEPLOY_ENV_FILE:-$DEPLOY_DIR/.env}"
compose=(docker compose --project-directory "$DEPLOY_DIR" --env-file "$BD_DEPLOY_ENV_FILE" -f "$COMPOSE_FILE")
if [[ -n "${BD_COMPOSE_OVERRIDE:-}" ]]; then
  compose+=(-f "$BD_COMPOSE_OVERRIDE")
fi
command_name="${1:-preflight}"
if [[ $# -gt 0 ]]; then shift; fi
check_network() {
  python3 "$SCRIPT_DIR/network_preflight.py" "$@" -- "${compose[@]}"
}
case "$command_name" in
  preflight) check_network "$@" ;;
  up|run|create|start|restart|build)
    check_network
    exec "${compose[@]}" "$command_name" "$@"
    ;;
  stop|ps|logs|config|pull) exec "${compose[@]}" "$command_name" "$@" ;;
  *) echo 'Usage: bdctl {preflight [--config-only]|up|run|create|start|restart|build|stop|ps|logs|config|pull} [options]' >&2; exit 2 ;;
esac
